# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Your domain, already pointing (A record) at this server's IP.
DOMAIN=poker.example.com

# Database password: letters and digits only (it goes into a URL).
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate with:  openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=change-me

# Optional: LLM commentary (OpenAI-compatible). Leave LLM_API_KEY empty to disable.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_DAILY_LIMIT=30
